classDiagram
    class Task {
        +str id
        +str description
        +time time
        +str frequency
        +int duration_minutes
        +str priority
        +bool is_complete
        +date due_date
        +mark_complete()
        +update()
    }

    class Pet {
        +str id
        +str name
        +str species
        +list tasks
        +add_task(task)
        +remove_task(task_id)
    }

    class Owner {
        +str name
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time(tasks)
        +filter_tasks(pet_name, is_complete)
        +complete_task(pet, task, completed_on)
        +detect_conflicts(date, start)
        +generate_schedule(date, start, available_minutes)
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : retrieves all pet tasks
